# ── 앱(프론트) 설정: Vite가 읽습니다. 실제 파일명은 .env 로 복사하세요. (.env 는 git에 올라가지 않습니다)

# 매일 갱신되는 가격 JSON 주소. 비워두면 개발용 샘플(public/data/prices.json)을 읽습니다.
VITE_DATA_URL=https://know77701.github.io/toss_app/prices.json

# 광고 그룹 ID. 콘솔 > 인앱 광고 > 광고 그룹에서 발급받은 값으로 교체하세요.
# 심사 요청 전에 반드시 테스트 ID를 실제 ID로 바꿔야 합니다. (테스트 키 잔존 = 전수점검 지적 항목)
VITE_AD_BANNER_ID=ait-ad-test-banner-id
VITE_AD_INTERSTITIAL_ID=ait-ad-test-interstitial-id
VITE_AD_REWARDED_ID=ait-ad-test-rewarded-id

# ── 수집 스크립트 설정: scripts/fetch-prices.mjs 가 읽습니다. GitHub Actions 에서는 Secrets 에 같은 이름으로 넣으세요.
# 값은 절대 코드나 문서에 적지 마세요.
DATA_GO_KR_KEY=      # 공공데이터포털 일반 인증키(Decoding). 농산물 가격·참가격 공용
FOODSAFETY_KEY=      # 식품안전나라 OpenAPI keyId (회수·판매중지 정보). 없으면 회수 정보만 생략됨
