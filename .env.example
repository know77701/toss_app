# ── 앱(프론트) 설정: Vite가 읽습니다. 실제 파일명은 .env 로 복사하세요.

# 매일 갱신되는 가격 JSON 주소. GitHub Pages 배포 후 아래 형식으로 바꾸세요.
# 예) https://<github아이디>.github.io/<저장소이름>/prices.json
# 비워두면 개발용 샘플(public/data/prices.json)을 읽습니다.
VITE_DATA_URL=

# 광고 그룹 ID. 콘솔 > 인앱 광고 > 광고 그룹에서 발급받은 값으로 교체하세요.
# 심사 요청 전에 반드시 테스트 ID를 실제 ID로 바꿔야 합니다. (테스트 키 잔존 = 전수점검 지적 항목)
VITE_AD_BANNER_ID=ait-ad-test-banner-id
VITE_AD_INTERSTITIAL_ID=ait-ad-test-interstitial-id
VITE_AD_REWARDED_ID=ait-ad-test-rewarded-id

# ── 수집 스크립트 설정: scripts/fetch-prices.mjs 가 읽습니다. (GitHub Actions에서는 Secrets에 넣으세요)
# 주의: 이 두 값은 Vite가 아니라 Node 스크립트가 읽으므로 셸 환경변수로 넘겨야 합니다.
#   PowerShell: $env:KAMIS_CERT_KEY="..."; $env:KAMIS_CERT_ID="..."; npm run fetch:prices
#   bash:       KAMIS_CERT_KEY=... KAMIS_CERT_ID=... npm run fetch:prices
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
